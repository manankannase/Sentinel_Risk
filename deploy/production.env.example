# Copy to .secrets/production.env; never commit populated files.
# Use URL-encoded passwords; use the least-privileged sentinel_api member role.
SENTINEL_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@DB_HOST/sentinel?sslmode=verify-full&sslrootcert=/run/sentinel/ca/postgres.pem
SENTINEL_REDIS_URL=rediss://USER:PASSWORD@REDIS_HOST:6379/0?ssl_cert_reqs=required&ssl_check_hostname=true&ssl_ca_certs=/run/sentinel/ca/redis.pem
SENTINEL_ALLOWED_HOSTS=risk.example.com,127.0.0.1
SENTINEL_MODEL_SHA256=replace-with-model-file-sha256
SENTINEL_MANIFEST_SHA256=replace-with-manifest-file-sha256
SENTINEL_RATE_PER_MINUTE=120
# Set broker in BOTH API and worker env files to enable reliable event publication.
# Empty broker means ledger-only: no outbox events are created in this mode.
SENTINEL_BROKER=
SENTINEL_BROKER_PROTOCOL=SASL_SSL
SENTINEL_BROKER_USERNAME=sentinel
SENTINEL_BROKER_PASSWORD=
SENTINEL_BROKER_CA_FILE=/run/sentinel/ca/kafka.pem
SENTINEL_TOPIC=sentinel.decisions.v2
